class SolarDataExtractor:
    """Handles all SQLite interactions with connection pooling."""
    
    _instance = None
    _conn = None
    
    def __new__(cls, db_name: str):
        """Singleton pattern to reuse connection"""
        if cls._instance is None or cls._instance.db_name != db_name:
            cls._instance = super(SolarDataExtractor, cls).__new__(cls)
            cls._instance.db_name = db_name
            cls._instance._initialize_connection()
        return cls._instance
    
    def _initialize_connection(self):
        """Initialize database connection with optimizations"""
        try:
            if self._conn:
                self._conn.close()
        except:
            pass
        
        self._conn = sqlite3.connect(self.db_name, check_same_thread=False)
        self._conn.execute("PRAGMA journal_mode=WAL")  # Better concurrency
        self._conn.execute("PRAGMA synchronous=NORMAL")  # Faster writes
        self._conn.execute("PRAGMA cache_size=-64000")  # 64MB cache
        self.cursor = self._conn.cursor()
    
    @property
    def conn(self):
        """Property to access connection"""
        return self._conn

    def extract_from_df(self, df: pd.DataFrame, table_name: str, mode: str = "replace", debug: bool = False):
        """Save DataFrame to database with chunking for large datasets"""
        try:
            if debug:
                print(f"[DEBUG] extract_from_df called:")
                print(f"  - DataFrame shape: {df.shape}")
                print(f"  - DataFrame columns: {list(df.columns)}")
                print(f"  - Table name: {table_name}")
                print(f"  - Mode: {mode}")
                print(f"  - Database: {self.db_name}")
                print(f"  - Connection: {self._conn}")
            
            # Use chunking for large dataframes
            chunksize = 10000 if len(df) > 10000 else None
            
            if debug:
                print(f"  - Chunksize: {chunksize}")
                print(f"  - Calling df.to_sql()...")
            
            df.to_sql(table_name, self._conn, if_exists=mode, index=False, chunksize=chunksize)
            
            if debug:
                print(f"  - to_sql() completed, committing...")
            
            self._conn.commit()
            
            if debug:
                print(f"  - Commit successful, clearing caches...")
            
            # Invalidate caches after writes
            self.list_tables.cache_clear()
            self.query_data.cache_clear()
            
            if debug:
                print(f"  - Success!")
            
            return True, f"Saved {len(df):,} rows to '{table_name}' (mode={mode})."
        except Exception as e:
            if debug:
                print(f"[DEBUG] Exception in extract_from_df:")
                print(f"  - Error: {e}")
                import traceback
                traceback.print_exc()
            self._conn.rollback()
            return False, f"Error saving: {e}"

    @lru_cache(maxsize=32)
    def query_data(self, query: str):
        """Execute query with caching for repeated queries"""
        try:
            df = pd.read_sql_query(query, self._conn)
            return True, df
        except Exception as e:
            return False, str(e)

    @lru_cache(maxsize=1)
    def list_tables(self):
        """List all tables with caching"""
        try:
            self.cursor.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
            return tuple(r[0] for r in self.cursor.fetchall())  # Tuple for caching
        except:
            return tuple()

    def delete_table(self, table_name: str):
        """Delete table and clear caches"""
        try:
            self.cursor.execute(f"DROP TABLE IF EXISTS {table_name}")
            self._conn.commit()
            # Clear caches
            self.list_tables.cache_clear()
            self.query_data.cache_clear()
            return True, f"Deleted table '{table_name}'."
        except Exception as e:
            self._conn.rollback()
            return False, str(e)
    
    def query_data_paginated(self, table_name: str, page: int = 1, page_size: int = 1000, 
                            where_clause: str = "", order_by: str = "") -> Tuple[bool, pd.DataFrame, int]:
        """
        Query data with pagination for large tables.
        
        Returns:
            (success, dataframe, total_count)
        """
        try:
            # Get total count
            count_query = f"SELECT COUNT(*) as count FROM {table_name}"
            if where_clause:
                count_query += f" WHERE {where_clause}"
            
            total = pd.read_sql_query(count_query, self._conn)['count'].iloc[0]
            
            # Get page data
            offset = (page - 1) * page_size
            query = f"SELECT * FROM {table_name}"
            if where_clause:
                query += f" WHERE {where_clause}"
            if order_by:
                query += f" ORDER BY {order_by}"
            query += f" LIMIT {page_size} OFFSET {offset}"
            
            df = pd.read_sql_query(query, self._conn)
            return True, df, total
        except Exception as e:
            return False, pd.DataFrame(), 0
    
    def get_table_schema(self, table_name: str) -> List[Dict]:
        """Get column information for a table"""
        try:
            self.cursor.execute(f"PRAGMA table_info({table_name})")
            columns = []
            for row in self.cursor.fetchall():
                columns.append({
                    'name': row[1],
                    'type': row[2],
                    'notnull': bool(row[3]),
                    'default': row[4],
                    'pk': bool(row[5])
                })
            return columns
        except:
            return []

class SolarDataAnalyzer:
    """Performs technical loss and budget variance calculations with optimized operations."""
    
    def __init__(self, df: pd.DataFrame, colmap: Dict[str, str]):
        self.df = df.copy()
        self.colmap = colmap
        self._validate_columns()
    
    def _validate_columns(self):
        """Validate that mapped columns exist in dataframe"""
        missing = []
        for key, col in self.colmap.items():
            if col and col not in self.df.columns:
                missing.append(f"{key} -> {col}")
        if missing:
            raise ValueError(f"Mapped columns not found in data: {', '.join(missing)}")
    
    def _get_col(self, key: str) -> Optional[str]:
        """Helper to safely get mapped column"""
        c = self.colmap.get(key)
        return c if c and c in self.df.columns else None
    
    def _normalize_percentage(self, series: pd.Series) -> pd.Series:
        """Convert percentage to decimal if needed (vectorized)"""
        return np.where(series > 1, series / 100, series)

    def compute_losses(self) -> pd.DataFrame:
        """
        Computes all loss and variance metrics efficiently using vectorized operations.
        """
        df = self.df
        
        # Get mapped columns
        col_Act = self._get_col("actual_gen")
        col_WAB = self._get_col("wab")
        col_Bud = self._get_col("budget_gen")
        col_PRa = self._get_col("pr_actual")
        col_PRb = self._get_col("pr_budget")
        col_Ava = self._get_col("availability")
        col_Cap = self._get_col("capacity")

        # --- Energy Variances (vectorized) ---
        if col_WAB and col_Act:
            df["Loss_Total_Tech_kWh"] = df[col_WAB] - df[col_Act]
        
        if col_WAB and col_Bud:
            df["Var_Weather_kWh"] = df[col_WAB] - df[col_Bud]
        
        if col_Act and col_Bud:
            df["Var_Total_Budget_kWh"] = df[col_Act] - df[col_Bud]

        # --- Component Losses ---
        if col_WAB:
            if col_PRa and col_PRb:
                pra = self._normalize_percentage(df[col_PRa])
                prb = self._normalize_percentage(df[col_PRb])
                df["Loss_PR_kWh"] = df[col_WAB] * (prb - pra)
            
            if col_Ava:
                ava = self._normalize_percentage(df[col_Ava])
                df["Loss_Avail_kWh"] = df[col_WAB] * (0.99 - ava)
        
        # --- PR Variance ---
        if col_PRa and col_PRb:
            pra = self._normalize_percentage(df[col_PRa])
            prb = self._normalize_percentage(df[col_PRb])
            df["Var_PR_pp"] = (prb - pra) * 100
        
        # --- Availability Variance ---
        if col_Ava:
            df["Var_Availability_pp"] = Config.TARGET_AVAILABILITY - df[col_Ava]
            df["Availability_Actual_%"] = df[col_Ava]
        
        # --- Yield ---
        if col_Act and col_Cap:
            capacity = df[col_Cap]
            if capacity.dtype == 'object':
                capacity = pd.to_numeric(capacity.astype(str).str.replace(',', ''), errors='coerce')
            df["Yield_kWh_per_kWp"] = df[col_Act] / capacity

        return df

